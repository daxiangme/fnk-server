# 管理端通用环境变量示例。
# 复制为 .env 后按本地环境修改；.env 已被 Git 忽略，禁止提交真实密钥和内部地址。

# 页面显示的版本号。
VITE_VERSION=1.0.0

# Vite 本地开发端口。
VITE_PORT=3006

# 应用部署基础路径，例如部署在 /admin/ 时填写 /admin/。
VITE_BASE_URL=/

# 权限模式：frontend 使用前端静态路由，backend 使用后端动态菜单。
VITE_ACCESS_MODE=backend

# 跨域请求是否携带 Cookie。
VITE_WITH_CREDENTIALS=false

# 是否在页面中显示路由调试信息。
VITE_OPEN_ROUTE_INFO=false

# 锁屏数据加密键；生产构建必须覆盖此示例值。
VITE_LOCK_ENCRYPT_KEY=change-me-before-production
