# Docker Compose 示例配置。
# 复制为 deploy/.env 后修改；deploy/.env 已被 Git 忽略，禁止提交真实密码和密钥。

# 对外暴露端口。
FRONTEND_PORT=3006
BACKEND_PORT=12345
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL 初始化库和运行账号。
MYSQL_DATABASE=fnk-service
MYSQL_USERNAME=fnk-service
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Redis 密码。
REDIS_PASSWORD=change-redis-password

# Sa-Token JWT 签名密钥，生产环境必须替换为足够长的随机值。
SA_TOKEN_JWT_SECRET=change-sa-token-jwt-secret

# JVM 参数。
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8

# 前端构建参数。锁屏密钥会进入浏览器产物，只用于本地数据混淆，不能作为服务端秘密。
VITE_BASE_URL=/
VITE_API_URL=/
VITE_LOCK_ENCRYPT_KEY=change-frontend-lock-key
